<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.1</Version>
  <Author>community</Author>
 </Creator>
 <Manufacturer>beamZ</Manufacturer>
 <Model>Par64 DMX 151.257 (177x10mm RGB) 6ch</Model>
 <Type>Color Changer</Type>
 <Channel Name="Master Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Strobe">
  <Group Byte="0">Strobe</Group>
  <Capability Min="0" Max="10">No strobe</Capability>
  <Capability Min="11" Max="255" Preset="ShutterStrobeSlowFast">Strobe, slow to fast</Capability>
 </Channel>
 <Channel Name="Mode">
  <Group Byte="0">Mode</Group>
  <Capability Min="0" Max="24">DMX mode</Capability>
  <Capability Min="25" Max="249">Built-in program (speed via Red channel)</Capability>
  <Capability Min="250" Max="255">Sound active (sensitivity via Red channel)</Capability>
 </Channel>
 <Mode Name="6 Channel">
  <Channel Number="0">Master Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">Strobe</Channel>
  <Channel Number="5">Mode</Channel>
 </Mode>
 <Physical>
  <Technical PowerConsumption="20" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
