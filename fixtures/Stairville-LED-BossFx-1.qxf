  <Group Byte="0">Strobe</Group>
  <Capability Min="0" Max="9">No function</Capability>
  <Capability Min="10" Max="255" Preset="ShutterStrobeSlowFast">Strobe, colour from ch 6-8</Capability>
 </Channel>
 <Channel Name="Spot 1 Dimmer" Preset="IntensityDimmer"/>
 <Channel Name="Spot 2 Red" Preset="IntensityRed"/>
 <Channel Name="Spot 2 Green" Preset="IntensityGreen"/>
 <Channel Name="Spot 2 Blue" Preset="IntensityBlue"/>
