<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.1</Version>
  <Author>community</Author>
 </Creator>
 <Manufacturer>Stairville</Manufacturer>
 <Model>LED BossFx-1 Bundle (28ch)</Model>
 <Type>Effect</Type>
 <Channel Name="Derby 1 Red" Preset="IntensityRed"/>
 <Channel Name="Derby 1 Green" Preset="IntensityGreen"/>
 <Channel Name="Derby 1 Blue" Preset="IntensityBlue"/>
 <Channel Name="Derby 1 Strobe">
  <Group Byte="0">Strobe</Group>
  <Capability Min="0" Max="9">No function</Capability>
  <Capability Min="10" Max="255" Preset="ShutterStrobeSlowFast">Strobe, speed increasing</Capability>
 </Channel>
 <Channel Name="Derby 1 Motor">
  <Group Byte="0">Movement</Group>
  <Capability Min="0" Max="4">Stopped</Capability>
  <Capability Min="5" Max="127">Clockwise, speed increasing</Capability>
  <Capability Min="128" Max="133">Stopped</Capability>
  <Capability Min="134" Max="255">Counter-clockwise, speed increasing</Capability>
 </Channel>
 <Channel Name="Spot 1 Red" Preset="IntensityRed"/>
 <Channel Name="Spot 1 Green" Preset="IntensityGreen"/>
 <Channel Name="Spot 1 Blue" Preset="IntensityBlue"/>
